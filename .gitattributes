# Normalise the line endings, so the files that land on the server are the
# files that were written, on every platform.
* text=auto eol=lf

*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.svg   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf

*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary

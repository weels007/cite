# Copy to .env and fill in the values you need.
#
# Only required for the testnets. StudioNet is gasless and needs nothing.
#
# ACCOUNT_PRIVATE_KEY_1=0x...
# ACCOUNT_PRIVATE_KEY_2=0x...
#
# LLM providers used by the local validator nodes (genlayer up / glsim):
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# HEURIST_API_KEY=
